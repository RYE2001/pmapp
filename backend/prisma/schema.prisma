generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  name          String
  weeklyCapacityMinutes Int @default(2400)
  createdAt     DateTime        @default(now())
  memberships   ProjectMember[]
  tasksAssigned Task[]          @relation("AssignedTasks")
  timeEntries   TimeEntry[]
  reportedBlockers Blocker[]        @relation("BlockerReporter")
  blockerComments  BlockerComment[]
  taskComments     TaskComment[]    @relation("TaskCommentAuthor")
  taskMentions     TaskCommentMention[]
  taskActivities   TaskActivity[]   @relation("TaskActivityActor")
  decisionPeople   DecisionPerson[]
  decisionsCreated Decision[]
  skills          UserSkill[]
  assignments     TaskAssignment[]
  timeBlocks      TimeBlock[]
  availability    Availability[]
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime        @default(now())
  members     ProjectMember[]
  tasks       Task[]
  decisions   Decision[]
  timeBlocks  TimeBlock[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  role      Role     @default(MEMBER)
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  joinedAt  DateTime @default(now())

  @@unique([userId, projectId])
}

model Task {
  id          String      @id @default(uuid())
  title       String
  description String?
  status      TaskStatus  @default(TODO)
  priority    Priority    @default(MEDIUM)
  startDate   DateTime?
  dueDate     DateTime?
  position    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  assignee    User?       @relation("AssignedTasks", fields: [assigneeId], references: [id])
  assigneeId  String?
  timeEntries TimeEntry[]
  blockers    Blocker[]
  comments    TaskComment[]
  activities  TaskActivity[]
  decisionLinks DecisionTask[]
  assignments   TaskAssignment[]
  timeBlocks    TimeBlock[]
  skillRequirements TaskSkillRequirement[]
}

model Skill {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  users       UserSkill[]
  taskRequirements TaskSkillRequirement[]
}

model UserSkill {
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  skill     Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId   String
  level     Int   @default(50)

  @@id([userId, skillId])
}

model TaskSkillRequirement {
  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  skill     Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId   String
  level     Int   @default(50)

  @@id([taskId, skillId])
}

model TaskAssignment {
  id             String     @id @default(uuid())
  plannedMinutes Int
  scheduledFor   DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  task           Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  timeBlock      TimeBlock?

  @@index([userId, scheduledFor])
  @@index([taskId, scheduledFor])
}

enum TimeBlockKind {
  WORK
  MEETING
  SUPPORT
  OTHER
}

model TimeBlock {
  id           String        @id @default(uuid())
  title        String
  kind         TimeBlockKind @default(WORK)
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId    String?
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId       String?
  assignment   TaskAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String?       @unique

  @@index([userId, startsAt])
  @@index([projectId, startsAt])
}

model Availability {
  id        String   @id @default(uuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId, startsAt])
}

model Decision {
  id              String           @id @default(uuid())
  title           String
  summary         String
  rationale       String
  alternatives    String?
  status          DecisionStatus   @default(ACTIVE)
  decidedAt       DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  createdBy       User             @relation(fields: [createdById], references: [id])
  createdById     String
  evidence        DecisionEvidence[]
  people          DecisionPerson[]
  taskLinks       DecisionTask[]

  @@index([projectId, status, decidedAt])
}

enum DecisionStatus {
  ACTIVE
  SUPERSEDED
  REVERSED
}

model DecisionEvidence {
  id          String   @id @default(uuid())
  label       String
  url         String?
  decision    Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  decisionId  String
}

model DecisionPerson {
  decision    Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  decisionId  String
  user        User     @relation(fields: [userId], references: [id])
  userId      String

  @@id([decisionId, userId])
}

model DecisionTask {
  decision    Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  decisionId  String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String

  @@id([decisionId, taskId])
}

model TaskComment {
  id        String               @id @default(uuid())
  message   String
  createdAt DateTime             @default(now())
  task      Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  author    User                 @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  authorId  String
  mentions  TaskCommentMention[]

  @@index([taskId, createdAt])
}

model TaskCommentMention {
  comment   TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  user      User        @relation(fields: [userId], references: [id])
  userId    String

  @@id([commentId, userId])
}

model TaskActivity {
  id        String   @id @default(uuid())
  action    String
  summary   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  actor     User     @relation("TaskActivityActor", fields: [actorId], references: [id])
  actorId   String

  @@index([taskId, createdAt])
}

model Blocker {
  id          String           @id @default(uuid())
  reason      String
  isExternal  Boolean          @default(false)
  resolved    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?
  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  createdBy   User             @relation("BlockerReporter", fields: [createdById], references: [id])
  createdById String
  comments    BlockerComment[]
}

model BlockerComment {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())
  blocker   Blocker  @relation(fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
}

model TimeEntry {
  id       String   @id @default(uuid())
  minutes  Int
  note     String?
  loggedAt DateTime @default(now())
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId   String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
}
